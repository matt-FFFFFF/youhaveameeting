--swiftversion 6.2
--indent 4
--maxwidth 110
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas inline
--self remove
--stripunusedargs closure-only
--exclude .build,build

# Single-line computed properties read better than the wrapped form here.
# swiftTestingTestCaseNames rewrites intentional prose @Test descriptions.
--disable wrapPropertyBodies,swiftTestingTestCaseNames
